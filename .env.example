# Copy to .env.local and fill in. NEVER commit real values.
# Only the public anon key belongs in the frontend. Never put a service-role key here.

# Public site URL (used for canonical links, Open Graph and the sitemap)
VITE_SITE_URL=https://your-domain.example

# Shop details below default to the values the owner supplied (see src/lib/config.ts).
# Set them only to override. WhatsApp number: digits with country code, e.g. 254782718496.
VITE_WHATSAPP_NUMBER=
VITE_BOOKING_FEE_KES=
VITE_POCHI_NUMBER=

# Public contact details - leave blank until confirmed by the shop
VITE_CONTACT_EMAIL=
VITE_INSTAGRAM_URL=
VITE_TIKTOK_URL=
VITE_STORE_CITY=
VITE_PICKUP_INFO=
VITE_DELIVERY_INFO=
VITE_RETURNS_POLICY=

# Supabase (optional until the admin/inventory backend is set up - see README)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
