# Copy to .env.local and fill in. NEVER commit real values.
# Only the public anon key belongs in the frontend. Never put a service-role key here.

# Public site URL (used for canonical links, Open Graph and the sitemap)
VITE_SITE_URL=https://your-domain.example

# Verified business WhatsApp number, digits only, with country code (e.g. 2547XXXXXXXX).
# Leave blank until confirmed: checkout then falls back to copy-to-clipboard.
VITE_WHATSAPP_NUMBER=

# Public contact details - leave blank until confirmed by the shop
VITE_CONTACT_EMAIL=
VITE_INSTAGRAM_URL=
VITE_STORE_CITY=
VITE_PICKUP_INFO=
VITE_DELIVERY_INFO=
VITE_RETURNS_POLICY=

# Supabase (optional until the admin/inventory backend is set up - see README)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
